flowchart TD

A[Admin Opens Financial Year]

A --> B[Financial Year Status = OPEN]

B --> C[Department Budget Created]

C --> D[Budget Status = DRAFT]

D --> E[HOD Enter Budget Items]

E --> F[Manual Entry]

E --> G[Excel Import]

E --> H[Copy From Previous Budget]

F --> I[Save Draft]
G --> I
H --> I

I --> J{Budget Ready?}

J -->|No| E

J -->|Yes| K[Submit Budget]

K --> L[Budget Status = PENDING_APPROVAL]

L --> M[Budget Approver Reviews Budget]

M --> N{Approve Budget?}

N -->|Return| O[Budget Status = RETURNED]

O --> P[Approver Adds General Or Item Notes]

P --> Q[HOD Reviews Notes]

Q --> R[Edit Same Budget]

R --> K

N -->|Approve| S[Budget Status = APPROVED]

S --> T{All Department Budgets Approved?}

T -->|No| U[Wait For Remaining Departments]

U --> T

T -->|Yes| V[Approver Starts PRE_CLOSING]

V --> W[Financial Year Status = PRE_CLOSING]

W --> X[Budgets Locked]

%% =====================================
%% ITEM REQUESTS
%% =====================================

B --> IR1[HOD Creates Category Or Item Request]

W --> IR1

IR1 --> IR2[Admin Reviews Request]

IR2 --> IR3{Approve Request?}

IR3 -->|Reject| IR4[Request Rejected]

IR3 -->|Approve| IR5[Create Category And Or Type]

%% =====================================
%% PO LINKING
%% =====================================

X --> PO1[PO Linking Enabled]

PO1 --> PO2[HOD Creates PO In CareWare]

PO2 --> PO3[Purchasing Approves PO]

PO3 --> PO4[Approved PO Available In Budget System]

PO4 --> PO5[Link PO Line To Budget Item]

PO5 --> PO6[Update Budget Balance]

%% =====================================
%% TRANSFERS
%% =====================================

X --> TR1[Transfer Requests Enabled]

TR1 --> TR2[HOD Creates Transfer Request]

TR2 --> TR3[Transfer Status PENDING_APPROVAL]

TR3 --> TR4[Approver Reviews Transfer]

TR4 --> TR5{Approve Transfer?}

TR5 -->|Reject| TR6[Transfer Status REJECTED]

TR5 -->|Approve| TR7[Transfer Status APPROVED]

TR7 --> TR8[Update Budget Balance]

%% =====================================
%% YEAR CLOSING
%% =====================================

PO6 --> CL1
TR6 --> CL1
TR8 --> CL1
IR4 --> CL1
IR5 --> CL1

CL1[Approver Starts Financial Year Closing]

CL1 --> CL2{Pending Transfer Requests?}

CL2 -->|Yes| CL3[Review Pending Transfer Requests]

CL2 -->|No| CL4{Pending PO Links?}

CL4 -->|Yes| CL5[Review Pending PO Links]

CL4 -->|No| CL6{Pending Item Or Category Requests?}

CL6 -->|Yes| CL7[Review Pending Item Requests]

CL6 -->|No| CL9[Financial Year Status = CLOSING]

CL3 --> CL1
CL5 --> CL1
CL7 --> CL1

CL9 --> CL10[Generate Final Reports]

CL10 --> CL11[Close Financial Year]

CL11 --> CL12[Financial Year Status = CLOSED]
