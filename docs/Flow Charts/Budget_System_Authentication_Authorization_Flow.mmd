flowchart TD

%% =====================================================
%% PORTAL AUTHENTICATION
%% =====================================================

A([Employee Opens Portal])

A --> B[Enter Username And Password]

B --> C{Portal Credentials Valid?}

C -->|No| D([Login Failed])

C -->|Yes| E[Portal Creates JWT Token]

E --> F[Store JWT In Browser]

F --> G[Open Budget System]

%% =====================================================
%% API REQUEST
%% =====================================================

G --> H[Frontend Sends API Request]

H --> I[Authorization Bearer JWT]

I --> J[Budget Backend]

%% =====================================================
%% JWT AUTHENTICATION
%% =====================================================

J --> K[verifyPortalJwt Middleware]

K --> L{JWT Exists?}

L -->|No| M([401 Unauthorized])

L -->|Yes| N[Verify JWT Signature]

N --> O{JWT Valid?}

O -->|No| P([401 Invalid Token])

O -->|Yes| Q[Extract User Information]

Q --> R["req.user"]

%% =====================================================
%% BUDGET ACCESS
%% =====================================================

R --> S[verifyBudgetAccess Middleware]

S --> T[Find User In BS_budget_user_roles]

T --> U{User Assigned To Budget System?}

U -->|No| V([403 No Budget Access])

U -->|Yes| W[Load User Budget Record]

%% =====================================================
%% ROLE LOADING
%% =====================================================

W --> X[Get role_id]

X --> Y[Load Role From BS_budget_roles]

Y --> Z[Load Role Permissions]

Z --> AA[BS_budget_role_permissions]

AA --> AB[Generate Base Permissions]

%% =====================================================
%% USER OVERRIDES
%% =====================================================

AB --> AC{User Specific Overrides?}

AC -->|Yes| AD[Apply User Overrides]

AC -->|No| AE[Keep Role Permissions]

AD --> AF[Build Final Permissions]
AE --> AF

%% =====================================================
%% ACCESS OBJECT
%% =====================================================

AF --> AG[Generate req.budgetAccess]

AG --> AH[Role]
AG --> AI[Department]
AG --> AJ[Permissions]
AG --> AK[isGlobalAdmin]

%% =====================================================
%% GLOBAL ADMIN
%% =====================================================

AK --> AL{Global Admin?}

AL -->|Yes| AM[Bypass Most Restrictions]

AL -->|No| AN[Permission Validation]

%% =====================================================
%% AUTHORIZATION
%% =====================================================

AN --> AO[requirePermission]

AO --> AP{Permission Granted?}

AP -->|No| AQ([403 Forbidden])

AP -->|Yes| AR[Execute Requested Service]

AM --> AR

%% =====================================================
%% MODULE SELECTION
%% =====================================================

AR --> AS{Requested Operation}

%% =====================================================
%% VIEW BUDGET
%% =====================================================

AS --> AT[View Budget]

AT --> AU{can_view_budget}

AU -->|No| AV([403])

AU -->|Yes| AW([Budget Visible])

%% =====================================================
%% EDIT BUDGET
%% =====================================================

AS --> AX[Create Or Edit Budget]

AX --> AY{can_edit_budget}

AY -->|No| AZ([403])

AY -->|Yes| BA([Budget Saved])

%% =====================================================
%% PURCHASE ORDER LINKING
%% =====================================================

AS --> BB[Link Purchase Order]

BB --> BC{can_link_po}

BC -->|No| BD([403])

BC -->|Yes| BE([PO Linked])

%% =====================================================
%% ITEM REQUEST WORKFLOW
%% =====================================================

AS --> BF[Create Item Request]

BF --> BG{can_edit_budget}

BG -->|No| BH([403])

BG -->|Yes| BI[Save Item Request]

BI --> BJ[Status PENDING]

BJ --> BK[Approver Reviews Request]

BK --> BL{can_approve_budget}

BL -->|No| BM([403])

BL -->|Yes| BN{Approve Request?}

BN -->|Reject| BO[Status REJECTED]

BN -->|Approve| BP[Status APPROVED]

BP --> BQ[Create Budget Item]

BQ --> BR([Budget Updated])

%% =====================================================
%% TRANSFER REQUEST WORKFLOW
%% =====================================================

AS --> BS[Create Transfer Request]

BS --> BT{can_request_transfer}

BT -->|No| BU([403])

BT -->|Yes| BV[Save Transfer Request]

BV --> BW[Status PENDING]

BW --> BX[Transfer Approver Reviews]

BX --> BY{can_approve_transfer}

BY -->|No| BZ([403])

BY -->|Yes| CA{Approve Transfer?}

CA -->|Reject| CB[Status REJECTED]

CA -->|Approve| CC[Status APPROVED]

CC --> CD[Apply Transfer]

CD --> CE[Update Source Budget Item]

CD --> CF[Update Destination Budget Item]

CE --> CG([Budget Updated])

CF --> CG

%% =====================================================
%% BUDGET APPROVAL
%% =====================================================

AS --> CH[Approve Budget]

CH --> CI{can_approve_budget}

CI -->|No| CJ([403])

CI -->|Yes| CK([Budget Approved])

%% =====================================================
%% USER MANAGEMENT
%% =====================================================

AS --> CL[Manage Users]

CL --> CM{can_manage_users}

CM -->|No| CN([403])

CM -->|Yes| CO([Users Updated])

%% =====================================================
%% CATEGORY MANAGEMENT
%% =====================================================

AS --> CP[Manage Categories]

CP --> CQ{can_manage_categories}

CQ -->|No| CR([403])

CQ -->|Yes| CS([Categories Updated])

%% =====================================================
%% REPORTS
%% =====================================================

AS --> CT[View Reports]

CT --> CU{can_view_reports}

CU -->|No| CV([403])

CU -->|Yes| CW([Reports Visible])

%% =====================================================
%% FINANCIAL YEARS
%% =====================================================

AS --> CX[Manage Financial Years]

CX --> CY{can_manage_financial_years}

CY -->|No| CZ([403])

CY -->|Yes| DA([Financial Year Updated])

%% =====================================================
%% SUCCESS
%% =====================================================

AW --> DB([Success])

BA --> DB
BE --> DB
BR --> DB
CG --> DB
CK --> DB
CO --> DB
CS --> DB
CW --> DB
DA --> DB