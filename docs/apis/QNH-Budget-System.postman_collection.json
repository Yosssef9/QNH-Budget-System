{
  "info": {
    "name": "QNH Budget System API",
    "_postman_id": "qnh-budget-system-api",
    "description": "Postman collection for QNH Budget System Admin APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:4000"
    },
    {
      "key": "TOKEN",
      "value": "PASTE_PORTAL_JWT_TOKEN_HERE"
    },
    {
      "key": "USER_ROLE_ID",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/auth/me",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - User Roles",
      "item": [
        {
          "name": "Get User Roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/admin/user-roles",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "admin", "user-roles"]
            }
          }
        },
        {
          "name": "Create User Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 123,\n  \"department_id\": 1,\n  \"role_id\": 1,\n  \"can_view_budget\": null,\n  \"can_edit_budget\": null,\n  \"can_link_po\": null,\n  \"can_request_transfer\": null,\n  \"can_approve_budget\": null,\n  \"can_approve_transfer\": null,\n  \"can_manage_users\": null,\n  \"can_manage_categories\": null,\n  \"can_view_reports\": null\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/admin/user-roles",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "admin", "user-roles"]
            }
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department_id\": 1,\n  \"role_id\": 1,\n  \"can_view_budget\": true,\n  \"can_edit_budget\": true,\n  \"can_link_po\": null,\n  \"can_request_transfer\": null,\n  \"can_approve_budget\": null,\n  \"can_approve_transfer\": null,\n  \"can_manage_users\": null,\n  \"can_manage_categories\": null,\n  \"can_view_reports\": null\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/admin/user-roles/{{USER_ROLE_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "admin", "user-roles", "{{USER_ROLE_ID}}"]
            }
          }
        },
        {
          "name": "Update User Role Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/admin/user-roles/{{USER_ROLE_ID}}/status",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "admin", "user-roles", "{{USER_ROLE_ID}}", "status"]
            }
          }
        }
      ]
    }
  ]
}